# Copy to apps/api/.env and fill in. Never commit .env.
# The Prisma CLI reads this same file, so migrations and the running server
# always agree about which database they are pointed at.

# ---- Database -------------------------------------------------------------
# Local Postgres:
#   postgresql://postgres:PASSWORD@localhost:5432/bluepencil
# Hosted (Neon, Supabase) — note sslmode:
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bluepencil"

# The API route tests run against a real database and truncate it between
# tests, so they must never touch the one above. Left unset, the suite appends
# `_test` to the database name in DATABASE_URL and creates it on first run.
# Set this only if the test database lives somewhere else entirely. The name
# must end in _test; the suite refuses to run otherwise.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bluepencil_test"

# ---- Server ---------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-64-hex-chars"

# Where the browser app is served from — used for CORS and cookie settings.
WEB_ORIGIN="http://localhost:5173"

# ---- Anthropic (Phase 3 — not needed yet) ---------------------------------
# Used only for tier-3 dialogue attribution. The app runs without it.
# ANTHROPIC_API_KEY="sk-ant-..."
