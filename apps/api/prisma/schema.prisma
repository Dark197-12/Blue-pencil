// Blue Pencil — data model.
//
// Phase 0 covers identity and the project shell only. Manuscript structure
// (chapter → scene → paragraph → line), characters, attributions, baselines
// and flags arrive in Phases 1–5, each as its own migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
  projects Project[]

  @@map("users")
}

/// Server-side sessions. The cookie carries only an opaque id, so signing out
/// on the server actually ends the session — unlike a self-contained JWT.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One manuscript under analysis.
model Project {
  id     String @id @default(cuid())
  userId String

  title  String
  author String?

  /// Normalised manuscript text, kept whole. Chapters and scenes index into it
  /// by character offset rather than copying slices, so structure can be
  /// re-detected or hand-corrected without ever mutating the author's words.
  sourceText String @default("")
  wordCount  Int    @default(0)

  /// Original upload, for provenance and for re-parsing after a parser fix.
  sourceFormat   String?
  sourceFilename String?

  /// Set once structure detection has run over sourceText.
  structureParsedAt DateTime?
  /// Set when the author has reviewed and accepted the chapter/scene split.
  structureConfirmedAt DateTime?

  /// Flag sensitivity, in standard deviations. Lower finds more and is wrong
  /// more often. 2.5 rather than 2 because fifteen metrics are measured per
  /// scene, and at 2 the noise alone yields roughly one false flag per scene.
  flagThreshold Float @default(2.5)
  /// Metrics the author has switched off — measures that are simply not what
  /// this book is doing.
  ignoredMetrics String[] @default([])
  /// Set once flag detection has run over the current attributions.
  flagsComputedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters   Chapter[]
  characters Character[]
  dialogue   DialogueLine[]
  flags      VoiceFlag[]

  @@index([userId, updatedAt])
  @@map("projects")
}

/// A chapter, addressed as a half-open range [startOffset, endOffset) into
/// Project.sourceText.
model Chapter {
  id        String @id @default(cuid())
  projectId String

  /// Position in the book, 0-based and always contiguous.
  index Int
  /// Heading line as it appears in the manuscript.
  heading String
  /// Number parsed from the heading, when there was one.
  ordinal Int?

  startOffset Int
  endOffset   Int
  wordCount   Int @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  Scene[]

  @@unique([projectId, index])
  @@index([projectId, startOffset])
  @@map("chapters")
}

/// A speaking character. Proposed from speech tags, then confirmed by the
/// author — detection suggests, the author decides.
model Character {
  id        String @id @default(cuid())
  projectId String

  /// Display name: the most frequent spelling seen in speech tags.
  name String
  /// Every spelling that refers to this character, including `name`.
  aliases String[]

  /// False until the author has reviewed the proposed cast.
  isConfirmed Boolean @default(false)
  /// Set when the author merges this character into another, or deletes it.
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attributions DialogueLine[]
  flags        VoiceFlag[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("characters")
}

/// One utterance. `segments` holds the quoted spans it is made of, because a
/// speech interrupted by its own tag — "Yes," she said, "of course" — is one
/// line in two pieces, and splitting it would corrupt sentence-length metrics.
model DialogueLine {
  id        String  @id @default(cuid())
  projectId String
  sceneId   String?

  /// Range covering the whole utterance, interrupting tag included.
  startOffset Int
  endOffset   Int
  /// [{ start, end }] for each quoted span, in order.
  segments Json

  /// Spoken words only, quote marks and tags removed.
  text      String
  wordCount Int    @default(0)

  /// Speaker exactly as the prose named them: "Elizabeth", "his wife", "she".
  /// Kept even when unresolvable, because Phase 3 resolves it from context.
  speakerRaw  String?
  /// name | pronoun | descriptor
  speakerKind String?

  characterId String?
  /// How the speaker was determined: tag | alternation | llm | manual.
  method String?
  /// 0–1. Speech tags are near-certain; inference is not.
  confidence Float?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene     Scene?     @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([projectId, startOffset])
  @@index([projectId, characterId])
  @@index([sceneId])
  @@map("dialogue_lines")
}

/// A scene within a chapter. Books that use no scene breaks get exactly one
/// scene per chapter, which is the honest answer rather than an invented split.
model Scene {
  id        String @id @default(cuid())
  chapterId String

  index       Int
  startOffset Int
  endOffset   Int
  wordCount   Int @default(0)

  /// How the preceding break was found: chapter-start, separator, blank-run.
  breakKind String @default("chapter-start")

  chapter  Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  dialogue DialogueLine[]
  flags    VoiceFlag[]

  @@unique([chapterId, index])
  @@index([chapterId, startOffset])
  @@map("scenes")
}

/// One character sounding unlike themselves in one scene.
///
/// The measurements here are derived and are rewritten wholesale every time
/// detection runs — attributions change, and a flag computed from stale ones
/// would be a lie. What is *not* derived is `dismissedAt`: the author saying
/// "this is deliberate" is a judgement the machine has no business discarding,
/// so recomputation upserts on (character, scene) and leaves it standing.
///
/// Dismissal is per scene rather than per metric because that is the shape of
/// the author's actual thought — "she is drunk in this scene" excuses every
/// measure at once, not the sentence length alone.
model VoiceFlag {
  id          String @id @default(cuid())
  projectId   String
  characterId String
  sceneId     String

  /// notable | strong
  severity String
  /// Largest deviation in the scene, used for ordering.
  peakZ Float
  /// [{ metric, label, baseline, observed, z, direction }] — the whole case,
  /// stored so the interface never has to recompute to explain itself.
  evidence Json
  /// Plain-language summary written for the author.
  summary String

  /// How much speech each side of the comparison rests on. Shown always: a
  /// flag from 60 words against 4 scenes deserves less trust than one from 400
  /// against 20, and only the author can weigh that.
  sceneWordCount     Int
  baselineWordCount  Int
  baselineSceneCount Int

  /// Set when the author marks the difference as intentional.
  dismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  scene     Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([characterId, sceneId])
  @@index([projectId, peakZ])
  @@index([sceneId])
  @@map("voice_flags")
}
