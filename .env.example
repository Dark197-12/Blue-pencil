# Copy to .env and fill in. Never commit .env.

# ---- Database -------------------------------------------------------------
# Any Postgres 14+ connection string. Free hosted options that work as-is:
#   Neon      https://neon.tech      (recommended — no card, instant)
#   Supabase  https://supabase.com
# Local Postgres also works:
#   postgresql://postgres:postgres@localhost:5432/bluepencil
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- API ------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-64-hex-chars"

# Where the browser app is served from, for CORS + cookie settings.
WEB_ORIGIN="http://localhost:5173"

# ---- Web ------------------------------------------------------------------
VITE_API_URL="http://localhost:3001"

# ---- Anthropic (Phase 3 — not needed yet) ---------------------------------
# Used only for tier-3 dialogue attribution. The app runs without it.
# ANTHROPIC_API_KEY="sk-ant-..."
